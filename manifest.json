{
  "manifest_version": 3,
  "name": "Blurr: for WhatsApp Web",
  "short_name": "Blurr",
  "version": "1.0.0",
  "description": "Share your screen, not your chats. Blur messages, names, pictures and media. Hover to read one. No internet, no data.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "settings.js",
        "surfaces.js",
        "content.js",
        "finder.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blurr",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-master": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Turn Blurr on or off"
    },
    "toggle-present": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Presentation mode on or off"
    }
  },
  "minimum_chrome_version": "111"
}